DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade_app
# Dev: password placeholder. Production WAJIB point ke hostname container di
# network `traefik`: redis://:<password>@redis:6379 (JANGAN localhost).
# Password harus sama dengan REDIS_PASSWORD di infra/redis/.env.
REDIS_URL=redis://:change-me@localhost:6379
INTERNAL_API_SECRET=change-me-in-env
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_PORT=3001
WORKER_PORT=3002
# CORS: daftar origin frontend yang diizinkan, dipisah koma.
# Wajib di prod karena FE memanggil API lintas subdomain
# (https://app.<domain> -> https://api.<domain>).
# Kosong/tidak diisi = izinkan semua origin (HANYA untuk dev).
CORS_ORIGINS=
ADMIN_EMAIL=<isi-nilai-nyata-di-env>
ADMIN_FULL_NAME=<isi-nilai-nyata-di-env>
ADMIN_PASSWORD=<isi-nilai-nyata-di-env>

# S3 / upload (Story gambar + Archive dokumen). Boleh dikosongkan saat dev tanpa S3;
# StorageService lazy-init dan hanya menolak saat endpoint upload dipanggil.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Opsional: override endpoint untuk MinIO/localstack (mis. http://localhost:9000)
S3_ENDPOINT=
UPLOAD_MAX_SIZE_MB=5
# Batas upload PDF dokumen Archive (default 10 MB) untuk POST /documents via DocumentUploadInterceptor.
UPLOAD_DOCUMENT_MAX_SIZE_MB=10
IMAGE_WEBP_QUALITY=82
IMAGE_LARGE_WIDTH=1920
IMAGE_MEDIUM_WIDTH=1024
IMAGE_THUMB_WIDTH=1280
IMAGE_THUMB_HEIGHT=720

# SMTP / email. Semua opsional; isi hanya bila butuh kirim email.
# SmtpService lazy-init: dev tanpa SMTP tetap boot, send() menolak dengan
# "Mail is not configured" selama SMTP_HOST/SMTP_FROM kosong.
SMTP_HOST=localhost
SMTP_PORT=587          # 587 = STARTTLS, 465 = TLS langsung (set SMTP_SECURE=true)
SMTP_SECURE=false      # 'true' untuk port 465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Gamelan Europe

# Email notifikasi konten terbit (worker merakit URL dari APP_WEB_URL + linkPath).
# Opsional: kosong = email terkirim tanpa link.
# APP_WEB_URL=https://app.example.com
# Concurrency consumer BullMQ (default 5).
# NOTIFICATION_WORKER_CONCURRENCY=5