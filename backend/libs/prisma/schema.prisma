generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SubscriptionType {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum BillingStatus {
  PENDING
  PAID
  CANCELED
}

enum BillingLineType {
  ITEM
  DISCOUNT
  TAX
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionRequestType {
  NEW
  RENEWAL
}

enum ContentStatus {
  DRAFT
  REQUEST
  APPROVED
  PUBLISHED
}

enum CategoryType {
  STORY
  ARCHIVE
}

enum ContentVisibility {
  PUBLIC
  PRIVATE
}

enum ArchiveType {
  MEMBER
  PUBLIC
}

enum ArchiveStatus {
  DRAFT
  REQUEST
  APPROVED
  PUBLISHED
}

enum ArchiveMaterialType {
  TUTORIALS
  DOCUMENTARIES
  RESEARCH
  DOCUMENTS
  HISTORY
}

enum NotificationType {
  CONTENT_PUBLISHED
  CONTENT_SUBMITTED
  SUBSCRIPTION_REQUEST_SUBMITTED
}

enum NotificationEntityType {
  POST
  EVENT
  ARCHIVE
  NETWORK
  SUBSCRIPTION_REQUEST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationChannel {
  EMAIL
}

// Diskriminator asal konten: REGISTERED (dibuat user login) vs PUBLIC (submit anonim).
enum ContentSource {
  PUBLIC
  REGISTERED
}

// Tiket masuk event: gratis, berbayar, atau reservasi.
enum EventEntry {
  FREE
  TICKET
  RESERVATION
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  fullName       String          @map("full_name")
  phone          String?
  address        String?
  avatar         String?
  countryId      String?         @map("country_id")
  country        Country?        @relation(fields: [countryId], references: [iso2], onDelete: SetNull)
  stateId        Int?            @map("state_id")
  state          State?          @relation(fields: [stateId], references: [id], onDelete: SetNull)
  passwordHash   String          @map("password_hash")
  status         UserStatus      @default(ACTIVE)
  roleId         String?         @map("role_id")
  role           Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  networkId      String?         @map("network_id")
  network        Network?        @relation(fields: [networkId], references: [id], onDelete: SetNull)
  refreshTokens  RefreshToken[]
  billings       Billing[]
  events         Event[]         @relation("EventCreator")
  posts          Post[]          @relation("PostCreator")
  archives       Archive[]       @relation("ArchiveCreator")
  createdNetworks Network[]      @relation("NetworkCreator")
  apiKeys        ApiKey[]        @relation("ApiKeyCreator")
  eventAuthors   EventAuthor[]   @relation("EventAuthor")
  postAuthors    PostAuthor[]    @relation("PostAuthor")
  archiveAuthors ArchiveAuthor[] @relation("ArchiveAuthor")
  subscriptionRequests         SubscriptionRequest[] @relation("SubscriptionRequester")
  reviewedSubscriptionRequests SubscriptionRequest[] @relation("SubscriptionRequestReviewer")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([networkId])
  @@index([countryId])
  @@index([stateId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String             @id @default(uuid())
  code        String             @unique
  description String?
  roles       RolePermission[]
  apiKeys     ApiKeyPermission[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Mirror ArchiveStatus: workflow status network (submission publik → review).
enum NetworkStatus {
  DRAFT
  REQUEST
  APPROVED
  PUBLISHED
}

model Network {
  id               String                   @id @default(uuid())
  name             String
  state            String?
  country          String?
  address          String?
  content          String?                  @db.Text
  website          String?
  contact          String?
  socialMedia      Json?                    @map("social_media")
  lat              Decimal?                 @db.Decimal(10, 7)
  lng              Decimal?                 @db.Decimal(10, 7)
  embedUrl         String?                  @map("embed_url")
  status           NetworkStatus            @default(DRAFT)
  source           ContentSource            @default(REGISTERED)
  publishedAt      DateTime?                @map("published_at")
  approvedAt       DateTime?                @map("approved_at")
  organisationType NetworkOrganisationType? @map("organisation_type")
  ledBy            String?                  @map("led_by")
  mapsUrl          String?                  @map("maps_url")
  activityType     String?                  @map("activity_type")
  countryId        Int?                     @map("country_id")
  stateId          Int?                     @map("state_id")
  cityId           Int?                     @map("city_id")
  city             City?                    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  submitterEmail   String?                  @map("submitter_email")
  createdBy        String?                  @map("created_by")
  creator          User?                    @relation("NetworkCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  users            User[]
  events           Event[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([cityId])
  @@map("networks")
}

model Subscription {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  subscriptionType SubscriptionType   @map("subscription_type")
  status           SubscriptionStatus @default(ACTIVE)
  currency         String
  price            Decimal            @db.Decimal(12, 2)
  durationInDays   Int                @map("duration_in_days")
  billings         Billing[]
  requests         SubscriptionRequest[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  @@map("subscriptions")
}

model Billing {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String           @map("subscription_id")
  subscription     Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  code             String           @unique
  status           BillingStatus    @default(PENDING)
  subscriptionType SubscriptionType @map("subscription_type")
  currency         String
  total            Decimal          @db.Decimal(12, 2)
  discount         Decimal?         @db.Decimal(12, 2)
  tax              Decimal?         @db.Decimal(12, 2)
  paidAt           DateTime?        @map("paid_at")
  canceledAt       DateTime?        @map("canceled_at")
  startDate        DateTime?        @map("start_date")
  expiryDate       DateTime?        @map("expiry_date")
  paymentProofUrl  String?          @map("payment_proof_url")
  paymentProofName String?          @map("payment_proof_name")
  lines            BillingLine[]
  subscriptionRequest SubscriptionRequest?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subscriptionId])
  @@map("billings")
}

model BillingLine {
  id          String          @id @default(uuid())
  billingId   String          @map("billing_id")
  billing     Billing         @relation(fields: [billingId], references: [id], onDelete: Cascade)
  description String
  type        BillingLineType
  qty         Int             @default(1)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([billingId])
  @@map("billing_lines")
}

model SubscriptionRequest {
  id             String                    @id @default(uuid())
  userId         String?                   @map("user_id")
  user           User?                     @relation("SubscriptionRequester", fields: [userId], references: [id], onDelete: SetNull)
  fullName       String                    @map("full_name")
  email          String
  phone          String?
  website        String?
  address        String?
  country        String?
  organisation   String?
  reason         String                    @db.Text
  subscriptionId String                    @map("subscription_id")
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  requestType    SubscriptionRequestType   @default(NEW) @map("request_type")
  status         SubscriptionRequestStatus @default(PENDING)
  reviewedById   String?                   @map("reviewed_by_id")
  reviewedBy     User?                     @relation("SubscriptionRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?                 @map("reviewed_at")
  reviewNote     String?                   @map("review_note")
  billingId      String?                   @unique @map("billing_id")
  billing        Billing?                  @relation(fields: [billingId], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([email])
  @@map("subscription_requests")
}

model Event {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  status      ContentStatus     @default(DRAFT)
  source      ContentSource     @default(REGISTERED)
  publishedAt DateTime?         @map("published_at")
  approvedAt  DateTime?         @map("approved_at")
  content     String
  thumbnail   String?
  visibility  ContentVisibility @default(PUBLIC)
  entry       EventEntry        @default(FREE)
  websiteUrl  String?           @map("website_url")
  createdBy   String?           @map("created_by")
  creator     User?             @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  networkId   String?           @map("network_id")
  network     Network?          @relation(fields: [networkId], references: [id], onDelete: SetNull)
  dates       EventDate[]
  eventTypes  AssignEventType[]
  locations   EventLocation[]
  authors     EventAuthor[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([networkId])
  @@map("events")
}

model EventDate {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("event_dates")
}

model EventType {
  id          String            @id @default(uuid())
  name        String
  assignments AssignEventType[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("event_types")
}

model AssignEventType {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTypeId String    @map("event_type_id")
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, eventTypeId])
  @@index([eventId])
  @@index([eventTypeId])
  @@map("assign_event_types")
}

model EventLocation {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  mapsUrl   String?  @map("maps_url")
  embedUrl  String?  @map("embed_url")
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)
  countryId Int?     @map("country_id")
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stateId   Int?     @map("state_id")
  state     State?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cityId    Int?     @map("city_id")
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@map("event_locations")
}

model Image {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  createdBy  String?  @map("created_by")
  key        String   @unique
  filename   String
  mimeType   String?  @map("mime_type")
  size       Int?
  width      Int?
  height     Int?
  variants   Json?
  order      Int      @default(0) @map("order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdBy])
  @@map("images")
}

model Post {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  status          ContentStatus     @default(DRAFT)
  source          ContentSource     @default(REGISTERED)
  publishedAt     DateTime?         @map("published_at")
  approvedAt      DateTime?         @map("approved_at")
  content         String
  thumbnail       String?
  galleryImageIds String[]          @default([]) @map("gallery_image_ids")
  flyerItems      Json              @default("[]") @map("flyer_items")
  visibility      ContentVisibility @default(PUBLIC)
  createdBy       String?           @map("created_by")
  creator         User?             @relation("PostCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  categories      PostCategory[]
  authors         PostAuthor[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("posts")
}

model Category {
  id        String            @id @default(uuid())
  name      String
  type      CategoryType
  posts     PostCategory[]
  archives  ArchiveCategory[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("categories")
}

model EventAuthor {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("EventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, authorId])
  @@index([eventId])
  @@index([authorId])
  @@map("event_authors")
}

model PostCategory {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
  @@map("post_categories")
}

model Archive {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  description   String?
  thumbnail     String?
  type          ArchiveType        @default(PUBLIC)
  status        ArchiveStatus      @default(DRAFT)
  publishedAt   DateTime?          @map("published_at")
  approvedAt    DateTime?          @map("approved_at")
  externalLinks String[]           @default([]) @map("external_links")
  documentIds   String[]           @default([]) @map("document_ids")
  source        ContentSource      @default(REGISTERED)
  date          DateTime?
  author        String?
  organisation  String?
  countryId     Int?               @map("country_id")
  stateId       Int?               @map("state_id")
  materialType  ArchiveMaterialType? @map("material_type")
  createdBy     String?            @map("created_by")
  creator       User?              @relation("ArchiveCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  categories    ArchiveCategory[]
  authors       ArchiveAuthor[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("archives")
}

model ArchiveCategory {
  id         String   @id @default(uuid())
  archiveId  String   @map("archive_id")
  archive    Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([archiveId, categoryId])
  @@index([archiveId])
  @@index([categoryId])
  @@map("archive_categories")
}

model PostAuthor {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([postId, authorId])
  @@index([postId])
  @@index([authorId])
  @@map("post_authors")
}

model ArchiveAuthor {
  id        String   @id @default(uuid())
  archiveId String   @map("archive_id")
  archive   Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("ArchiveAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([archiveId, authorId])
  @@index([archiveId])
  @@index([authorId])
  @@map("archive_authors")
}

// Tabel dokumen terpisah (mirror `images` minus kolom image-specific).
model Document {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  key        String   @unique
  filename   String
  mimeType   String?  @map("mime_type")
  size       Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@map("documents")
}

model Region {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  translations Json?
  wikiDataId   String?   @map("wiki_data_id")
  countries    Country[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("regions")
}

model Country {
  id             Int             @id @default(autoincrement())
  name           String
  iso2           String          @unique @db.Char(2)
  iso3           String?         @db.Char(3)
  numericCode    String?         @map("numeric_code")
  phoneCode      String?         @map("phone_code")
  capital        String?
  currency       String?
  currencyName   String?         @map("currency_name")
  currencySymbol String?         @map("currency_symbol")
  tld            String?
  native         String?
  population     BigInt?
  gdp            BigInt?
  regionName     String?         @map("region_name")
  subregion      String?
  nationality    String?
  timezones      Json?
  translations   Json?
  latitude       Decimal?        @db.Decimal(10, 8)
  longitude      Decimal?        @db.Decimal(11, 8)
  emoji          String?
  emojiU         String?         @map("emoji_u")
  wikiDataId     String?         @map("wiki_data_id")
  regionId       Int?            @map("region_id")
  region         Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  users          User[]
  states         State[]
  cities         City[]
  eventLocations EventLocation[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("countries")
}

model ApiKey {
  id          String             @id @default(uuid())
  name        String
  keyHash     String             @unique @map("key_hash")
  prefix      String             @map("prefix")
  lastUsedAt  DateTime?          @map("last_used_at")
  createdBy   String             @map("created_by")
  creator     User               @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  permissions ApiKeyPermission[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("api_keys")
}

model ApiKeyPermission {
  apiKeyId     String     @map("api_key_id")
  permissionId String     @map("permission_id")
  apiKey       ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([apiKeyId, permissionId])
  @@index([permissionId])
  @@map("api_key_permissions")
}

model State {
  id             Int             @id
  name           String
  countryCode    String          @map("country_code") @db.Char(2)
  fipsCode       String?         @map("fips_code")
  iso2           String?
  iso3166_2      String?
  type           String?
  level          Int?
  parentId       Int?            @map("parent_id")
  native         String?
  latitude       Decimal?        @db.Decimal(10, 8)
  longitude      Decimal?        @db.Decimal(11, 8)
  timezone       String?
  translations   Json?
  wikiDataId     String?         @map("wiki_data_id")
  countryId      Int             @map("country_id")
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  users          User[]
  cities         City[]
  eventLocations EventLocation[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([countryCode])
  @@map("states")
}

model City {
  id         Int             @id @default(autoincrement())
  name       String
  countryId  Int             @map("country_id")
  country    Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  stateId    Int?            @map("state_id")
  state      State?          @relation(fields: [stateId], references: [id], onDelete: SetNull)
  latitude   Decimal?        @db.Decimal(10, 8)
  longitude  Decimal?        @db.Decimal(11, 8)
  wikiDataId String?         @map("wiki_data_id")
  locations  EventLocation[]
  networks   Network[]
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([stateId])
  @@map("cities")
}

enum NetworkOrganisationType {
  GAMELAN_GROUP
  ASSOCIATION
  INSTITUTION
}

model Notification {
  id          String                 @id @default(uuid())
  userId      String                 @map("user_id")
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  entityType  NotificationEntityType @map("entity_type")
  entityId    String                 @map("entity_id")
  title       String
  body        String?                @db.Text
  imageUrl    String?                @map("image_url")
  linkPath    String?                @map("link_path")
  status      NotificationStatus     @default(PENDING)
  lastError   String?                @map("last_error")
  scheduledAt DateTime               @default(now()) @map("scheduled_at")
  sentAt      DateTime?              @map("sent_at")
  readAt      DateTime?              @map("read_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@unique([userId, type, entityType, entityId])
  @@index([status, scheduledAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  channel      NotificationChannel @default(EMAIL)
  emailEnabled Boolean             @map("email_enabled") @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

