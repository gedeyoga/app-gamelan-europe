{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/app/src",
  "monorepo": true,
  "defaultProject": "app",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/app/tsconfig.app.json"
  },
  "projects": {
    "app": {
      "type": "application",
      "root": "apps/app",
      "sourceRoot": "apps/app/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/app/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "sourceRoot": "apps/worker/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    },
    "libs": {
      "type": "library",
      "root": "libs",
      "sourceRoot": "libs/src"
    }
  }
}